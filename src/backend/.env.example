# 复制为 .env 后填写
REDIS_URL=redis://localhost:6380/0
OCR_PYTHON=/path/to/conda/envs/v312/bin/python
# PaddleOCR/Docling 模型与解析缓存目录
PADDLE_PDX_CACHE_HOME=/path/to/backend/data/paddlex-cache
DOCLING_CACHE_DIR=/path/to/backend/data/docling-cache
# 设置后 OCR 走该 PaddleOCR 容器服务（见 backend/paddleocr_service），
# 不设置则在 OCR_PYTHON 环境内直接调用本地 PaddleOCR
# PADDLEOCR_SERVICE_URL=http://127.0.0.1:8900
TAVILY_API_KEY=tvly-xxxxxxxx
TAVILY_ENABLED=true

# 对外 API Key（逗号分隔，/api/v1/* 鉴权）
API_KEYS=your-secret-key-here
API_AUTH_ENABLED=true

# LangGraph 智能体（多 Provider）
LLM_PROVIDER=bailian
# anthropic | openai | zhipu | bailian
LLM_MODEL=qwen3.5-plus
BAILIAN_API_KEY=sk-xxxxxxxx
# 或 DASHSCOPE_API_KEY=sk-xxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TIMEOUT_SEC=3600
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
SKIP_AGENT=false
# 兼容旧变量：SKIP_CLAUDE=true 等同于 SKIP_AGENT
AGENT_STREAM_TO_CONSOLE=true
AGENT_PARALLEL_WORKERS=4
OCR_CONFIDENCE_THRESHOLD=0.7
