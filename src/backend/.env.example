# 复制为 .env 后填写
REDIS_URL=redis://localhost:6380/0
OCR_PYTHON=/path/to/conda/envs/v312/bin/python
TAVILY_API_KEY=tvly-xxxxxxxx
TAVILY_ENABLED=true

# 对外 API Key（逗号分隔，/api/v1/* 鉴权）
API_KEYS=your-secret-key-here
API_AUTH_ENABLED=true

# LangGraph 智能体（多 Provider）
LLM_PROVIDER=bailian
# anthropic | openai | zhipu | bailian
LLM_MODEL=qwen3.5-plus
BAILIAN_API_KEY=sk-xxxxxxxx
# 或 DASHSCOPE_API_KEY=sk-xxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TIMEOUT_SEC=3600
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0
SKIP_AGENT=false
# 兼容旧变量：SKIP_CLAUDE=true 等同于 SKIP_AGENT
AGENT_STREAM_TO_CONSOLE=true
AGENT_PARALLEL_WORKERS=4
OCR_CONFIDENCE_THRESHOLD=0.7

# 以下三项留空即保持默认行为；隔离网/虚拟机部署建议全部开启（见浙商 VM）
# DOCLING_NUM_THREADS=4
# OMP_WAIT_POLICY=PASSIVE
# HF_OFFLINE=true

# 模型服务前有反向代理时须开启，否则长请求会被读超时掐断
# LLM_STREAMING=true

# 按场景指定模型，留空或不设即用上面的 LLM_MODEL
# GENERAL 覆盖 general / classification / extraction 三类任务
# LLM_MODEL_GENERAL=
# LLM_MODEL_CASE1=
# LLM_MODEL_CASE2=

# 以下两项留空即保持原行为；仅在模型异常无限生成时作止损用
# LLM_MAX_TOKENS：单次输出上限，0 或不设=不限制；如 4096
# LLM_STOP：停止词，逗号分隔，支持 \n \t \r 转义；如 \n\n
# LLM_MAX_TOKENS=4096
# LLM_STOP=\n\n

# Qwen thinking 开关，仅用于 OpenAI/vLLM 兼容接口；不设置即保持模型服务默认行为
# LLM_ENABLE_THINKING=false

# 退化探测：流式输出中连续空白字符超过该值即判为模型空转并中止本次调用，默认 200，0=关闭
# 量化模型在结构化输出下会在 JSON 冒号后无限吐空格，此时连接上一直有数据，
# LLM_TIMEOUT_SEC 这类读超时拦不住，只能靠内容判断。依赖 LLM_STREAMING=true
# LLM_DEGENERATION_WHITESPACE_RUN=200

# OCR 增强（仅财务报表场景，默认只对 case2 生效）
# OCR_TEXT_LAYER_GUARD：文本层金额已损坏的 PDF 改用强制整页 OCR
# OCR_TABLE_SPLIT：把被 docling 并成一张的双栏资产负债表拆回两半
# OCR_GUARD_KINDS：上面两项生效的场景，逗号分隔；留空=全部
# OCR_TEXT_LAYER_GUARD=true
# OCR_TABLE_SPLIT=true
# OCR_GUARD_KINDS=case2

# 跳过 OCR 阶段（调试用，跳过后智能体拿不到材料文本）
# SKIP_OCR=false

# 上传体积上限（MB）
# MAX_ZIP_MB=5000
# MAX_COLLECTION_MB=20

# PPTX 转 PDF 用的 LibreOffice
# LIBREOFFICE_BIN=soffice
# PPTX_CONVERT_TIMEOUT_SEC=300

# 未设 OCR_PYTHON 时的回退：conda run -n <CONDA_ENV>
# CONDA_BIN=conda
# CONDA_ENV=v312

# 默认 sqlite:///<backend>/data/app.db
# DATABASE_URL=

# 派生路径，一般无需设置：
# UPLOADS_DIR / EXTRACTS_DIR / SKILLS_SOURCE_DIR / CASE1_TEMPLATE_PATH / OCR_SCRIPT
